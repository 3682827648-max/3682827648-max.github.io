<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>星环科技 - Deep Space Rings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    body {
      /* 纯黑深空背景 */
      background: #000;
      width: 100vw;
      height: 100vh;
      user-select: none;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .center-wrap {
      /* 居中包裹容器 */
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      z-index: 2;
      pointer-events: none;
    }
    .title-neon {
      /* 霓虹渐变发光标题 */
      font-family: 'Segoe UI', 'Arial', 'PingFang SC', 'Microsoft YaHei', sans-serif;
      font-size: clamp(2.2rem, 6vw, 4.5rem);
      letter-spacing: 0.09em;
      font-weight: 600;
      line-height: 1.15;
      background: linear-gradient(90deg, #66ccff 20%, #fff 40%, #ff99ff 60%, #66ff57 85%);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      position: relative;
      text-align: center;
      box-shadow: none;
      filter: drop-shadow(0 0 8px #fff) drop-shadow(0 0 15px #6cf) drop-shadow(0 0 30px #b6f);
      /* 呼吸霓虹动画 */
      animation: neon-breath 3.5s ease-in-out infinite;
      text-shadow:
        0 0 12px #66ccff,
        0 0 22px #fff,
        0 0 28px #b070ff,
        0 0 55px #0ff;
      z-index: 3;
      pointer-events: auto;
      cursor: pointer;
      user-select: text;
    }
    @keyframes neon-breath {
      0% { filter: brightness(1.04) drop-shadow(0 0 12px #66ccff); }
      50% { filter: brightness(1.52) drop-shadow(0 0 32px #ff99ff); }
      100% { filter: brightness(1.04) drop-shadow(0 0 12px #66ccff); }
    }
    /* 顶部标题覆盖星环中央 */
    .title-neon {
      margin-bottom: 2vh;
      margin-top: 0;
      /* 居中定位 */
      left: 50%; top: 7vh; transform: translate(-50%, 0);
      width: max-content;
      position: absolute;
    }
    /* 禁用滚动条 */
    ::-webkit-scrollbar { display: none; }
  </style>
</head>
<body>
  <canvas id="stars-canvas"></canvas>
  <div class="center-wrap">
    <div class="title-neon">星环科技<br>Deep Space Rings</div>
  </div>
  <script>
    // 获取 canvas 和设置全屏
    const canvas = document.getElementById('stars-canvas');
    const ctx = canvas.getContext('2d');
    // 记录画布像素密度
    let dpr = window.devicePixelRatio || 1;

    // 星环配置
    const RING_COUNT = 6;         // 星环层数
    const RING_PARTICLES = [120, 105, 90, 78, 65, 53]; // 每层粒子数
    const RING_RADII =      [330, 270, 200, 150, 100, 70];    // 星环基础半径
    const RING_THICK =      [24, 16, 12, 10, 8, 7];          // 环厚度
    const RING_SPEED =      [0.14, -0.15, 0.11, -0.08, 0.05, -0.04]; // 旋转速度(rad/s)
    const RING_DIR =        [1, -1, 1, -1, 1, -1];           // 正、反方向
    const RING_BLUR =       [20, 15, 10, 8, 7, 6];           // 环辉光模糊半径

    const PARTICLE_MIN_SIZE = 1.2, PARTICLE_MAX_SIZE = 2.45;

    let width = 0, height = 0;

    // 3D 透视参数
    let cameraZ = 780;                       // 视点Z
    let perspective = 850;                   // 透视距离
    let rings = [];                          // 星环层对象数组

    // 交互参数
    let rotationX = 0, rotationY = 0;        // 3D旋转角度（欧拉角制）
    let targetRotationX = 0, targetRotationY = 0; // 鼠标交互目标角度
    let isDragging = false;
    let lastMouseX = 0, lastMouseY = 0;
    let scale = 1.0, targetScale = 1.0;     // 星环整体缩放

    // 随机微扰用
    function rand(a, b) { return a + Math.random()*(b-a);}
    function lerp(a,b,t){return a+(b-a)*t;}

    // 适应全屏
    function resizeCanvas() {
      dpr = window.devicePixelRatio || 1;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // 粒子构造
    class Particle {
      constructor(u, ringIdx) {
        // u: 在圆环上的角位置，0~2π
        this.u = u;
        this.ringIdx = ringIdx;
        this.baseAlpha = rand(0.38, 0.74);  // 闪烁基本透明度
        this.alphaSpeed = rand(0.6, 1.3);
        this.alphaPhi = rand(0, Math.PI*2);
        this.size = rand(PARTICLE_MIN_SIZE, PARTICLE_MAX_SIZE) * (1 - ringIdx * 0.06) * dpr;
        this.ghost = Math.random() < 0.15 ? 1 : 0; // 随机亮粒作主环点
      }
      // 获取该粒子闪烁的当前透明度
      getAlpha(time) {
        // 闪烁: 基础透明+正弦微扰
        return this.baseAlpha + 0.32 * Math.sin(time * this.alphaSpeed + this.alphaPhi);
      }
      // 获取粒子亮度因子
      getGlow(time) {
        return this.ghost ? (1.2 + 0.7*Math.sin(time*1.1+this.alphaPhi)) : 1;
      }
    }

    // 星环构造
    class StarRing {
      constructor(idx) {
        this.idx = idx;
        this.radius = RING_RADII[idx];
        this.particleCount = RING_PARTICLES[idx];
        this.thickness = RING_THICK[idx];
        this.particles = [];
        // 粒子均匀分布星环，并微扰角度，让环不死板整齐
        for(let i=0;i<this.particleCount;i++) {
          const u = 2*Math.PI * i/this.particleCount + rand(-0.01,0.01) + idx*0.06;
          this.particles.push(new Particle(u, idx));
        }
        this.rotate = rand(0, Math.PI*2); // 当前自身旋转相位
        this.speed = RING_SPEED[idx];
        this.dir = RING_DIR[idx];
        this.blur = RING_BLUR[idx] * dpr;
      }
      update(dt) {
        this.rotate += this.dir * this.speed * dt;
      }
    }

    // 初始化所有星环
    function initRings() {
      rings = [];
      for(let i=0;i<RING_COUNT;i++) rings.push(new StarRing(i));
    }
    initRings();

    // 坐标旋转工具-计算世界坐标旋转后在画布上的投影
    function rotatePoint3D([x,y,z], rx, ry) {
      // 绕X轴旋转rx
      let cosa = Math.cos(rx), sina = Math.sin(rx);
      let y1 = y * cosa - z * sina;
      let z1 = y * sina + z * cosa;

      // 绕Y轴旋转ry
      let cosb = Math.cos(ry), sinb = Math.sin(ry);
      let x2 = x * cosb + z1 * sinb;
      let z2 = -x * sinb + z1 * cosb;
      return [x2, y1, z2];
    }

    // 立体透视投影
    function project3D([x,y,z]) {
      let zz = z + cameraZ;
      // 使用标准透视投影
      let px = x * perspective / zz;
      let py = y * perspective / zz;
      return [px, py, zz];
    }

    // 渲染动画主循环
    let lastTime = 0;
    function animate(timeStamp) {
      let time = timeStamp * 0.001;
      let dt = lastTime === 0 ? 0.016 : time - lastTime;
      lastTime = time;

      // 缓动：平滑旋转和缩放
      let ease = 0.11;
      rotationX = lerp(rotationX, targetRotationX, ease);
      rotationY = lerp(rotationY, targetRotationY, ease);
      scale = lerp(scale, targetScale, 0.18);

      // 清空画布
      ctx.clearRect(0,0,canvas.width,canvas.height);

      // 计算视觉中心
      const cx = width/2*dpr, cy = height/2*dpr;
      ctx.save();
      // 整体缩放（由鼠标滚轮控制）
      ctx.translate(cx, cy);
      ctx.scale(scale,scale);
      ctx.translate(-cx, -cy);

      // 绘制每层星环，远层先画
      for(let ri=RING_COUNT-1;ri>=0;ri--) {
        let ring = rings[ri];
        ring.update(dt ? dt : 0.016);

        // 层辉光效果(Group)
        ctx.save();
        ctx.globalAlpha = 0.9-(ri*0.10);
        ctx.filter = `blur(${ring.blur}px)`; // 辉光模糊
        // 对整个星环进行旋转
        for(let pi=0;pi<ring.particleCount;pi++) {
          let p = ring.particles[pi];
          // 星环参数 u : 粒子在圆上的位置角度
          let theta = p.u + ring.rotate;
          // 星环宽度扰动波形
          let rad = ring.radius + Math.sin(theta*2.4 + time*0.3) * ring.thickness * rand(0.15,0.36);

          // 形成三维环的坐标
          let x = Math.cos(theta) * rad;
          let y = Math.sin(theta) * rad;
          // 星环垂直层面，整体向上倾斜一定角度（物理层次感）
          let z = (Math.sin(theta*1.04 + ri*0.22 + time*0.42)*0.64 + (ri-2.5)*0.41)*ring.thickness*2.1;

          // 层级距离渲染
          let [xf, yf, zf] = rotatePoint3D([x, y, z], rotationX, rotationY);
          let [sx, sy, sz] = project3D([xf, yf, zf]);
          let px = Math.round(sx + cx), py = Math.round(sy + cy);

          // 越远变小，弱透明
          let alphaFade = 1-Math.max(0,Math.min(1, (sz-400)/1700));
          let particleAlpha = Math.min(1, alphaFade * (p.getAlpha(time)+0.12));
          // 强粒子更亮
          let glow = 1.15*p.getGlow(time);

          // 粒子本身带发光晕
          let g = ctx.createRadialGradient(px, py, 0.7*p.size, px, py, 3.2*p.size+ri*0.8);
          g.addColorStop(0, `rgba(255,255,255,${particleAlpha*0.75*glow})`);
          g.addColorStop(0.35, `rgba(185,255,255,${particleAlpha*0.33*glow})`);
          g.addColorStop(1, `rgba(80,148,255,0)`);
          ctx.beginPath();
          ctx.arc(px, py, 2.8*p.size, 0, Math.PI*2);
          ctx.fillStyle = g;
          ctx.fill();
        }
        ctx.restore();

        // 绘制主核心环点（不带blur更锐利）
        ctx.save();
        ctx.globalAlpha = 1.0-(ri*0.08);
        for(let pi=0;pi<ring.particleCount;pi++) {
          let p = ring.particles[pi];
          if(!p.ghost) continue;
          // 计算参数同上
          let theta = p.u + ring.rotate;
          let rad = ring.radius + Math.sin(theta*2.4 + time*0.3) * ring.thickness * rand(0.05,0.18);

          let x = Math.cos(theta) * rad;
          let y = Math.sin(theta) * rad;
          let z = (Math.sin(theta*1.04 + ri*0.22 + time*0.42)*0.62 + (ri-2.5)*0.54)*ring.thickness*2.0;

          let [xf, yf, zf] = rotatePoint3D([x, y, z], rotationX, rotationY);
          let [sx, sy, sz] = project3D([xf, yf, zf]);
          let px = Math.round(sx + cx), py = Math.round(sy + cy);

          let particleAlpha = Math.max(0, Math.min(1, p.getAlpha(time) + 0.17));
          ctx.beginPath();
          ctx.arc(px, py, p.size, 0, Math.PI*2);
          ctx.fillStyle = `rgba(255,255,255,${particleAlpha*0.98})`;
          ctx.shadowColor = "#fff";
          ctx.shadowBlur = 6 + ri*1.7;
          ctx.fill();
        }
        ctx.restore();
      }
      ctx.restore();

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);

    // ---- 交互系统：鼠标/滚轮控制 ----
    // 1. 鼠标移动 = 目标倾斜角
    document.addEventListener('mousemove', e => {
      // 鼠标拖拽时优先使用拖角
      if(isDragging) return;
      let nx = (e.clientX/width-0.5)*2;
      let ny = (e.clientY/height-0.5)*2;
      // X: 绕右轴转, Y: 绕上轴转（角度限制双侧极限）
      targetRotationY = nx * Math.PI/7;
      targetRotationX = ny * Math.PI/8;
    });
    // 鼠标滚轮 = 缩放
    document.addEventListener('wheel', e => {
      e.preventDefault();
      if(e.deltaY < 0) targetScale *= 1.08;
      else targetScale *= 0.93;
      // 缩放限值
      if(targetScale < 0.35) targetScale = 0.35;
      if(targetScale > 2.7) targetScale = 2.7;
    }, {passive:false});
    // 鼠标左键按住拖拽自旋
    canvas.addEventListener('mousedown', e => {
      if(e.button !== 0) return;
      isDragging = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      document.body.style.cursor = "grabbing";
    });
    document.addEventListener('mouseup', ()=> {
      isDragging = false;
      document.body.style.cursor = "";
    });
    // 拖拽时实时更改当前角（不缓动）
    document.addEventListener('mousemove', e => {
      if(!isDragging) return;
      let dx = e.clientX - lastMouseX;
      let dy = e.clientY - lastMouseY;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      let scale = 0.007;
      rotationY += dx * scale;
      rotationX += dy * scale;
      // 限制倾斜角度[-60°, +60°]避免过度
      rotationX = Math.max(-Math.PI/2.5, Math.min(Math.PI/2.5, rotationX));
      rotationY = Math.max(-Math.PI/2.4, Math.min(Math.PI/2.4, rotationY));
      targetRotationX = rotationX;
      targetRotationY = rotationY;
    });

    // 双击页面重置视角和缩放
    canvas.addEventListener('dblclick', ()=>{
      targetRotationX = 0; targetRotationY = 0; targetScale = 1.0;
    });

    // 浏览器窗口变化自动适应
    window.addEventListener('resize', ()=>{
      resizeCanvas();
      initRings();
    });

    // 防止“全屏无留白”，页面全屏覆盖处理
    document.body.style.overflow = "hidden";
    document.documentElement.style.overflow = "hidden";
  </script>
</body>
</html>
